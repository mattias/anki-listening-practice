    <string name="onboarding_welcome">ברוכים הבאים ל-Listening Practice</string>
    <string name="onboarding_welcome_body">אמנו את האוזן עם משפטים ממילים שאתם כבר מכירים: מכרטיסי ה-Anki, מהסרטונים שלכם ומ-YouTube. כל משפט חוזר עד שתבינו אותו, והטקסט נשאר מוסתר עד שתרצו לראות אותו.</string>
    <string name="onboarding_study_title">מה אתם לומדים?</string>
    <string name="onboarding_study_body">חפיסות, סרטונים, רשימות מילים ומילונים נשמרים בנפרד לכל שפה, כך שאפשר להחליף בכל רגע.</string>
    <string name="onboarding_dictionaries_body">עם מילונים אפשר להקיש על כל מילה במשפט כדי לחפש אותה ולסמן אותה כמוכרת או להתעלם ממנה. אלה המילונים ש-Hachidori מתקין כברירת מחדל; הם מתעדכנים בעצמם.</string>
    <string name="onboarding_dictionaries_background">ההתקנה ממשיכה ברקע, כך שאפשר להמשיך מיד.</string>
    <string name="onboarding_no_recommended">עדיין אין מילונים מוכנים עבור %1$s. בהמשך תוכלו לייבא כל מילון Yomitan בהגדרות ← מילונים.</string>
    <string name="onboarding_words_title">המילים והכרטיסים שלכם</string>
    <string name="onboarding_words_body">האפליקציה משמיעה רק משפטים ממילים שאתם מכירים. ייבאו את המילים המוכרות לכם (מ-Jiten, ‏Anki Miner או Migaku) ואת חפיסת ה-Anki שלכם; אפשר גם מאוחר יותר בהגדרות.</string>
    <string name="onboarding_videos_body">סרטונים עם כתוביות וקישורי YouTube מוסיפים בהגדרות ← סרטונים ושמע.</string>
    <string name="onboarding_tips_title">כדאי לדעת</string>
    <string name="onboarding_tip_play">לחצו על השמעה והאזינו. המשפט חוזר עד שתקישו על ברור לגמרי, או מעצמו אחרי מספר ההשמעות שבחרתם.</string>
    <string name="onboarding_tip_words">הקישו על הכרטיס כדי להציג את הטקסט, ואז על מילה כדי לחפש אותה ולסמן אותה כמוכרת או להתעלם ממנה.</string>
    <string name="onboarding_tip_undo">חץ החזרה מחזיר אתכם למשפט הקודם ומבטל את מה שעשיתם בו.</string>
    <string name="onboarding_tip_auto">כדי להאזין בלי ידיים, הגדירו ברור לגמרי או דילוג אוטומטי אחרי כמה השמעות.</string>
    <string name="onboarding_tip_headset">עם אוזניות: הקשה להשמעה או השהיה, הקשה כפולה לדילוג. בהתראה יש את אותם כפתורים.</string>
    <string name="auto_advance_after">להמשיך אוטומטית אחרי</string>
    <string name="wiktionary_help">מילונים מוויקימילון, לכל שפה שאפשר ללמוד. הם מתעדכנים בעצמם.</string>
